local function createOverlayButton(name, text, defaultPos, callback)
    local btnFrame = Instance.new("Frame")
    btnFrame.Name = name .. "_OverlayBtn"
    btnFrame.Parent = ScreenGui
    btnFrame.BackgroundColor3 = Color3.fromRGB(10, 12, 18)
    btnFrame.BackgroundTransparency = 0.4
    btnFrame.Position = defaultPos
    btnFrame.Size = UDim2.new(0, 80, 0, 80)
    btnFrame.Active = true
    btnFrame.Draggable = true

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 16)
    corner.Parent = btnFrame

    local stroke = Instance.new("UIStroke")
    stroke.Parent = btnFrame
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(80, 255, 180)

    local btn = Instance.new("TextButton")
    btn.Parent = btnFrame
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.TextWrapped = true

    local toggled = false
    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            stroke.Color = Color3.fromRGB(80, 255, 80)
            btnFrame.BackgroundColor3 = Color3.fromRGB(0, 120, 60)
        else
            stroke.Color = Color3.fromRGB(80, 255, 180)
            btnFrame.BackgroundColor3 = Color3.fromRGB(10, 12, 18)
        end
        callback(toggled)
    end)
    return btnFrame
end

