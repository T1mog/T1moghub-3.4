RunService.Stepped:Connect(function()
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    
    if espEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hl = espCache[player] or Instance.new("Highlight", CoreGui)
                hl.Adornee = player.Character
                espCache[player] = hl
                local role = getPlayerRole(player)
                hl.FillColor = role == "Murderer" and Color3.fromRGB(255, 0, 0) or (role == "Sheriff" and Color3.fromRGB(0, 0, 255) or Color3.fromRGB(0, 255, 0))
            end
        end
    else
        for player, hl in pairs(espCache) do hl:Destroy(); espCache[player] = nil end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local head = player.Character.Head
            local existingGui = head:FindFirstChild("T1mog_BoxESP")
            
            if boxEspEnabled then
                if not existingGui then
                    local bg = Instance.new("BillboardGui")
                    bg.Name = "T1mog_BoxESP"
                    bg.Size = UDim2.new(0, 100, 0, 50)
                    bg.StudsOffset = Vector3.new(0, 2.5, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = head
                    
                    local txt = Instance.new("TextLabel")
                    txt.Name = "Info"
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 11
                    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                    txt.TextStrokeTransparency = 0.5
                    txt.Parent = bg
                end
                
                local info = existingGui:FindFirstChild("Info")
                if info and rootPart and player.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = math.floor((rootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
                    info.Text = player.Name .. "\n[" .. dist .. " studs]"
                end
            else
                if existingGui then existingGui:Destroy() end
            end
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pRoot = player.Character.HumanoidRootPart
            local arrowGui = arrowCache[player]
            
            if arrowEspEnabled then
                if not arrowGui then
                    arrowGui = Instance.new("ScreenGui")
                    arrowGui.Name = "T1mog_Arrow_" .. player.Name
                    arrowGui.Parent = CoreGui
                    
                    local arrowLabel = Instance.new("TextLabel")
                    arrowLabel.Name = "Arrow"
                    arrowLabel.Size = UDim2.new(0, 30, 0, 30)
                    arrowLabel.AnchorPoint = Vector2.new(0.5, 0.5)
                    arrowLabel.BackgroundTransparency = 1
                    arrowLabel.Font = Enum.Font.GothamBold
                    arrowLabel.Text = "▲"
                    arrowLabel.TextSize = 18
                    arrowLabel.TextColor3 = getPlayerRole(player) == "Murderer" and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(255, 255, 255)
                    arrowLabel.Parent = arrowGui
                    
                    arrowCache[player] = arrowGui
                end
                
                local arrow = arrowGui:FindFirstChild("Arrow")
                if arrow and rootPart then
                    local _, onScreen = Camera:WorldToViewportPoint(pRoot.Position)
                    if not onScreen then
                        arrow.Visible = true
                        local camCF = Camera.CFrame
                        local relPos = camCF:PointToObjectSpace(pRoot.Position)
                        local angle = math.atan2(relPos.X, relPos.Z)
                        local radius = 180
                        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        
                        local pos = screenCenter + Vector2.new(math.sin(angle) * radius, -math.cos(angle) * radius)
                        arrow.Position = UDim2.new(0, pos.X, 0, pos.Y)
                        arrow.Rotation = math.deg(angle) + 180
                    else
                        arrow.Visible = false
                    end
                end
            else
                if arrowGui then arrowGui:Destroy(); arrowCache[player] = nil end
            end
        end
    end
    
    if wallBangEnabled then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then obj.CanQuery = false end
        end
    end
    
    if noclipEnabled then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
    
    if hitboxEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.Size = Vector3.new(4, 4, 4)
            end
        end
    end
    
    if coinsEnabled and rootPart then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj.Name == "Coin_Server" or obj.Name == "Coin") and obj:IsA("BasePart") then
                rootPart.CFrame = obj.CFrame
                task.wait(0.1)
                break
            end
        end
    end
    
    if speedGlitchEnabled and humanoid and rootPart then
        if humanoid.MoveDirection.Magnitude > 0 then
            character:TranslateBy(humanoid.MoveDirection * 0.5)
        end
    end
    
    if autoGunEnabled and rootPart then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj.Name == "GunDrop" or obj.Name == "Gun") and obj:IsA("BasePart") then
                rootPart.CFrame = obj.CFrame
                task.wait(0.1)
                break
            end
        end
    end
    
    if skinChangerEnabled then
        applySkinChanger()
    end
end)
