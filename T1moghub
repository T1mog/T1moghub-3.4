local function createTab(name, iconText)
    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Parent = ContentArea
    page.BackgroundTransparency = 1
    page.Size = UDim2.new(1, 0, 1, 0)
    page.Visible = false
    page.ScrollBarThickness = 3
    
    local layout = Instance.new("UIListLayout")
    layout.Parent = page
    layout.Padding = UDim.new(0, 6)
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 15)
    end)
    
    local btn = Instance.new("TextButton")
    btn.Parent = Sidebar
    btn.BackgroundColor3 = Color3.fromRGB(22, 27, 38)
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = "  " .. iconText .. "  " .. name
    btn.TextColor3 = Color3.fromRGB(150, 165, 190)
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do t.Visible = false end
        for _, b in pairs(tabButtons) do 
            b.TextColor3 = Color3.fromRGB(150, 165, 190) 
            b.BackgroundTransparency = 1
        end
        page.Visible = true
        btn.TextColor3 = Color3.fromRGB(80, 160, 255)
        btn.BackgroundTransparency = 0.5
    end)
    
    tabs[name] = page
    table.insert(tabButtons, btn)
    return page
end

